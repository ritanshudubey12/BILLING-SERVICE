{
  "name": "billing-service",
  "version": "1.0.0",
  "description": "Comprehensive Billing & Invoicing Service Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "docker:build": "docker build -t billing-service .",
    "docker:run": "docker compose up -d",
    "docker:down": "docker compose down"
